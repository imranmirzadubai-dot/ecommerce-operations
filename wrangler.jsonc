/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ecommerce-operations",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-07",
  "assets": {
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  },
  "upload_source_maps": true,
  "env": {
    "staging": {
      "name": "ecommerce-operations-staging",
      "workers_dev": true,
      "vars": {
        "ENVIRONMENT": "staging",
        "SUPABASE_URL": "https://mijbpvgxrxjaalimyqgm.supabase.co"
      }
    }
  }
  /**
   * Production remains the top-level Worker: ecommerce-operations.
   * Production SUPABASE_URL and SUPABASE_PUBLISHABLE_KEY are supplied by
   * the existing production deployment configuration/secrets and are not
   * committed to source control.
   *
   * Staging uses the isolated Worker above and the staging Supabase URL.
   * SUPABASE_PUBLISHABLE_KEY must be supplied as a staging Worker secret.
   * The browser-side VITE_SUPABASE_* values are supplied separately at build time.
   */
}
